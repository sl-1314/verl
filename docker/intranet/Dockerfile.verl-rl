# ==============================================================================
# verl (RL) + sglang (Rollout) + Megatron (Train) · Python 3.12 内网镜像 (Dockerfile.verl-rl)
#
# 目标版本组合:
#   - Base 镜像: 内网 nvidia-cuda:12.9.1-devel-ubuntu22.04 (imageId: 642392771)
#   - Python: 3.12.3 (conda-forge)
#   - PyTorch: torch==2.13.0+cu129, torchvision==0.28.0+cu129, torchaudio==2.11.0+cu129 (cp312)
#   - Rollout: sglang @ 4349538c02 + sglang_kernel==0.4.6.post1+cu129 + flashinfer_python[cu12]==0.6.18
#   - Train  : megatron-core==0.19.2 + megatron-bridge==0.6.2 + transformer-engine==2.16.1 + apex + flash-attn==2.8.3
#   - RL     : verl @ 0938fcb3 + ray[default] + tensordict + torchdata + trl==0.27.0 + liger-kernel==0.8.4
# 构建约束: 单阶段线性构建 (无 BuildKit / 无多阶段 / 无 --mount=type=cache，直接对齐 MLP components)
# 溯源纪律: 每一条命令均已在同构容器内亲手执行并验证，注释中标注 build-notes.md 流水号 (#RXX)
# ==============================================================================

# [#R01] 固定内网基础镜像
FROM registry-offlinebiz.sankuai.com/custom_prod/com.sankuai.data.hadoop.gpu/nvidia-cuda:12.9.1-devel-ubuntu22.04

# [#R01, #R02, #R13] 基础环境变量、Rust 工具链、cuDNN wheel 动态库路径与缓存配置
ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    PATH="/opt/verl/bin:/opt/sglang-rust/cargo/bin:/usr/local/cuda/bin:/usr/local/nvidia/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/verl/lib:/opt/verl/lib/python3.12/site-packages/nvidia/cudnn/lib:/opt/verl/lib/python3.12/site-packages/nvidia/nccl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}" \
    CARGO_HOME=/opt/sglang-rust/cargo \
    RUSTUP_HOME=/opt/sglang-rust/rustup \
    RUSTUP_DIST_SERVER=https://rsproxy.cn \
    RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup \
    PIP_CACHE_DIR=/opt/sglang-cache/pip \
    CONDA_PKGS_DIRS=/opt/sglang-cache/conda \
    HF_HOME=/opt/sglang-cache/hf \
    HF_ENDPOINT=https://hf-mirror.com \
    HF_HUB_DISABLE_XET=1 \
    no_proxy="pip.sankuai.com,pypi.sankuai.com,data-source-conda.sankuai.com,.sankuai.com,127.0.0.1,localhost"

# [#R02] S1: 使用美团内网 Conda 源创建独立 Python 3.12.3 环境 /opt/verl 并安装 libprotobuf (提供 protoc)
RUN mkdir -p /opt/sglang-rust /opt/sglang-cache/pip /opt/sglang-cache/conda /opt/sglang-cache/hf \
    && /usr/local/miniconda3/bin/conda create -y -p /opt/verl \
        --override-channels \
        -c http://data-source-conda.sankuai.com/cloud/conda-forge/ \
        -c http://data-source-conda.sankuai.com/pkgs/main/ \
        python=3.12 libprotobuf \
    && /opt/verl/bin/python -V \
    && /opt/verl/bin/protoc --version

# [#R03] S1: 升级打包与 C++/CUDA 构建工具链 (pybind11 / ninja / setuptools-rust 等)
RUN /opt/verl/bin/pip install \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        --upgrade "pip" "setuptools>=61.0" "setuptools-rust>=1.11" "setuptools-scm>=8.0" \
        "wheel" "html5lib" "six" "pybind11" "ninja" "packaging>=24.2" "psutil"

# [#R01 / SGLang #08] S3: 通过 rsproxy.cn 镜像安装独立 Rust 工具链 (>= 1.85，供 sglang-grpc / sglang-mm 编译)
RUN http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
    sh -c 'curl --proto "=https" --tlsv1.2 --retry 3 --retry-delay 2 -sSf https://rsproxy.cn/rustup-init.sh | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable' \
    && printf '[source.crates-io]\nreplace-with = "rsproxy-sparse"\n[source.rsproxy]\nregistry = "https://rsproxy.cn/crates.io-index"\n[source.rsproxy-sparse]\nregistry = "sparse+https://rsproxy.cn/index/"\n[registries.rsproxy]\nindex = "https://rsproxy.cn/crates.io-index"\n[net]\ngit-fetch-with-cli = true\n' > /opt/sglang-rust/cargo/config.toml \
    && /opt/sglang-rust/cargo/bin/rustc --version \
    && /opt/sglang-rust/cargo/bin/cargo --version

# [#R04] S3: 从美团内网源秒装全部 CUDA 12.9 / cuDNN 9.20 / NCCL 2.29 / Triton 底层依赖，再安装 cp312 版 torch 2.13.0+cu129 三件套
RUN /opt/verl/bin/pip install \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        "typing-extensions>=4.10.0" \
        "nvidia-cudnn-cu12==9.20.0.48" "nvidia-cusparselt-cu12==0.8.1" \
        "nvidia-nccl-cu12==2.29.7" "nvidia-nvshmem-cu12==3.4.5" \
        "triton==3.7.1" "cuda-bindings==12.9.10" "cuda-python==12.9.10" \
        "nvidia-cublas-cu12==12.9.1.4" "nvidia-cuda-cupti-cu12==12.9.79" \
        "nvidia-cuda-nvrtc-cu12==12.9.86" "nvidia-cuda-runtime-cu12==12.9.79" \
        "nvidia-cufft-cu12==11.4.1.4" "nvidia-cufile-cu12==1.14.1.1" \
        "nvidia-curand-cu12==10.3.10.19" "nvidia-cusolver-cu12==11.7.5.82" \
        "nvidia-cusparse-cu12==12.5.10.65" "nvidia-nvjitlink-cu12==12.9.86" \
        "nvidia-nvtx-cu12==12.9.79" \
        "filelock" "sympy>=1.13.3" "networkx>=2.5.1" "jinja2" "fsspec>=0.8.5" "numpy>=2.0.0" "pillow" \
    && http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
       /opt/verl/bin/pip install --no-deps \
        --index-url https://mirrors.nju.edu.cn/pytorch/whl/cu129 \
        "cuda-toolkit==12.9.1" "torch==2.13.0+cu129" "torchvision==0.28.0+cu129" "torchaudio==2.11.0+cu129"

# [#R05] S3: 下载 sglang_kernel-0.4.6.post1+cu129 (cp310-abi3) 并校验官方 SHA256 后安装到 Python 3.12 环境
RUN WHL_FILE="/opt/sglang-cache/pip/sglang_kernel-0.4.6.post1+cu129-cp310-abi3-manylinux2014_x86_64.whl" \
    && curl -fL --retry 3 -x http://10.177.8.11:3128 -o "$WHL_FILE" \
        "https://gh-proxy.com/https://github.com/sgl-project/whl/releases/download/v0.4.6.post1/sglang_kernel-0.4.6.post1+cu129-cp310-abi3-manylinux2014_x86_64.whl" \
    && echo "9d400246b3f2512e2c33611e1bb6a2f252c499c5019e9f331f9c9ee215be95ab  $WHL_FILE" | sha256sum -c - \
    && /opt/verl/bin/pip install --no-deps --force-reinstall "$WHL_FILE"

# [#R06] S3: 安装 flashinfer_python[cu12]==0.6.18 与 nvidia-cutlass-dsl==4.6.2 (锁定 cuda-python==12.9.10 与 nvidia-cudnn-frontend==1.28.0)
RUN http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
    /opt/verl/bin/pip install --no-deps -i https://pypi.org/simple/ "nccl4py==0.6.0" \
    && http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
       /opt/verl/bin/pip install -i https://mirrors.aliyun.com/pypi/simple/ \
        "cuda-core==1.2.2" "cuda-python==12.9.10" "cuda-bindings==12.9.10" \
        "nvidia-cutlass-dsl-libs-cu12==4.6.2" "nvidia-cutlass-dsl-libs-base==4.6.2" "nvidia-cutlass-dsl==4.6.2" \
    && /opt/verl/bin/pip install \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        "cuda-python==12.9.10" "cuda-bindings==12.9.10" \
        "cuda-tile==1.6.0rc5" "apache-tvm-ffi==0.1.11" \
        "nvidia-cudnn-frontend==1.28.0" "flashinfer_python[cu12]==0.6.18"

# [#R07, #R16] S3: 批量安装 sglang + verl[verl-core] 共享依赖 (锁定 transformers==5.12.1, tokenizers==0.22.2, protobuf==6.33.6)
RUN printf 'torch==2.13.0+cu129\ntorchvision==0.28.0+cu129\ntorchaudio==2.11.0+cu129\ncuda-python==12.9.10\ncuda-bindings==12.9.10\nnvidia-cudnn-frontend==1.28.0\nprotobuf==6.33.6\ntransformers==5.12.1\ntokenizers==0.22.2\n' > /opt/sglang-cache/constraints-cu129-py312.txt \
    && /opt/verl/bin/pip install \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        -c /opt/sglang-cache/constraints-cu129-py312.txt \
        "aiohttp" "anthropic>=0.20.0" "blobfile==3.0.0" "build" \
        "compressed-tensors==0.18.0" "datasets" "distro" "easydict" "einops" \
        "fastapi" "gguf" "interegular" "IPython" \
        "llguidance>=1.7.6,<2.0.0" "mistral_common>=1.11.5" "modelscope" \
        "msgspec" "ninja" "numba==0.65.1" "numpy>=2.0.0" \
        "nvidia-ml-py" "openai==2.6.1" "openai-harmony==0.0.4" "orjson" \
        "outlines==0.1.11" "packaging>=24.2" "partial_json_parser" "pillow" \
        "prometheus-client>=0.20.0" "psutil" "py-spy" "pybase64" "pydantic" \
        "python-multipart" "pyzmq>=25.1.2" "requests" \
        "scipy" "sentencepiece" "setproctitle" "smg-grpc-servicer>=0.5.0" \
        "soundfile==0.13.1" "tiktoken" "timm==1.0.16" "tokenizers==0.22.2" \
        "torch_memory_saver>=0.0.9.post1" "torchcodec==0.15.0" \
        "tqdm" "transformers==5.12.1" "uvicorn" "uvloop" "watchfiles" \
        "xgrammar==0.2.1" "xxhash" "zstandard" \
        "accelerate" "codetiming" "dill" "hydra-core" "pandas" "peft" \
        "pyarrow>=19.0.0" "pybind11" "pylatexenc" "ray[default]>=2.41.0" \
        "torchdata" "tensordict>=0.8.0,<=0.10.0,!=0.9.0" "wandb" "tensorboard" \
        "mathruler" "qwen_vl_utils" "cachetools" "nvtx" "liger-kernel==0.8.4" \
        "trl==0.27.0" "flash-linear-attention==0.5.2" "math-verify" "latex2sympy2_extended" \
        "pytest" "pytest-asyncio" "pytest-rerunfailures" "pre-commit" "onnxscript" "matplotlib" \
    && /opt/verl/bin/pip install --no-deps \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        "protobuf==6.33.6" "quack-kernels==0.6.4" "tilelang==0.1.12" "kernels==0.14.1" \
    && http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
       /opt/verl/bin/pip install --no-deps \
        -i https://mirrors.aliyun.com/pypi/simple/ \
        --extra-index-url https://pypi.org/simple/ \
        "kernels-data>=0.14.0.dev1" "nvidia-mathdx==25.6.0" \
        "humming-kernels==0.1.12" "tokenspeed_mla==0.1.8" "TransferQueue>=0.1.11"

# [#R09, #R10, #R11, #R13, #R15, #R19] S4: 安装 Megatron 训练栈 (cupy-cuda12x + megatron-core 0.19.2 + megatron-bridge 0.6.2 + energon/modelopt 依赖 + FA2 2.8.3 + FA4 4.0.0b37 + apex + TE 2.16.1)
RUN ln -sfn /usr/lib/x86_64-linux-gnu/libnuma.so.1 /opt/verl/lib/libnuma.so \
    && /opt/verl/bin/pip install \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        -c /opt/sglang-cache/constraints-cu129-py312.txt \
        "cupy-cuda12x==14.0.1" "megatron-core==0.19.2" \
        "braceexpand" "filetype>=1.0.0" "mfusepy" "s3fs" "webdataset" "pulp<4.0" "deprecation" \
    && /opt/verl/bin/pip install --no-deps \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        "megatron-bridge==0.6.2" "fsspec==2026.7.0" "opentelemetry-api==1.44.0" \
    && http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
       /opt/verl/bin/pip install \
        -i https://mirrors.aliyun.com/pypi/simple/ \
        -c /opt/sglang-cache/constraints-cu129-py312.txt \
        "multi-storage-client>=0.40.0" \
    && http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
       /opt/verl/bin/pip install --no-deps \
        -i https://mirrors.aliyun.com/pypi/simple/ \
        --extra-index-url https://pypi.org/simple/ \
        "megatron-energon==7.4.1" "nvidia-modelopt==0.44.0" "rapidyaml>=0.10.0" \
    && FLASH_ATTENTION_FORCE_BUILD=TRUE FLASH_ATTN_CUDA_ARCHS="90" TORCH_CUDA_ARCH_LIST="9.0" MAX_JOBS=64 NVCC_THREADS=2 \
       /opt/verl/bin/pip install --no-build-isolation --no-deps \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        "flash-attn==2.8.3" \
    && /opt/verl/bin/pip install --no-deps \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        "flash-attn-4==4.0.0b37" \
    && http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
       git clone --depth=1 https://gh-proxy.com/https://github.com/NVIDIA/apex.git /tmp/apex-src \
    && TORCH_CUDA_ARCH_LIST="9.0" MAX_JOBS=64 NVCC_APPEND_FLAGS="--threads 4" APEX_CPP_EXT=1 APEX_CUDA_EXT=1 \
       /opt/verl/bin/pip install -v --disable-pip-version-check --no-build-isolation --no-deps \
        --config-settings "--build-option=--cpp_ext --cuda_ext" /tmp/apex-src \
    && rm -rf /tmp/apex-src \
    && NVIDIA_SITE="/opt/verl/lib/python3.12/site-packages/nvidia" \
       CPATH="${NVIDIA_SITE}/cudnn/include:${NVIDIA_SITE}/nccl/include" \
       LIBRARY_PATH="${NVIDIA_SITE}/cudnn/lib:${NVIDIA_SITE}/nccl/lib" \
       TORCH_CUDA_ARCH_LIST="9.0" MAX_JOBS=64 \
       /opt/verl/bin/pip install --no-build-isolation --no-deps \
        -i http://pip.sankuai.com/simple/ --trusted-host pip.sankuai.com \
        "transformer-engine-cu12==2.16.1" "transformer-engine==2.16.1" "transformer-engine-torch==2.16.1"

# [#R08, #R14, #R15] S4: 安装 sglang @ 4349538c02 与 verl @ 0938fcb3 (editable)，并验证全栈导入
RUN http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
    git clone https://gh-proxy.com/https://github.com/sgl-project/sglang.git /opt/verl-sglang-src \
    && git -C /opt/verl-sglang-src checkout -f 4349538c02 \
    && sed -i \
        -e 's/"cuda-python>=13\.0"/"cuda-python>=12,<13"/' \
        -e 's/"flashinfer_python\[cu13\]==0\.6\.18"/"flashinfer_python[cu12]==0.6.18"/' \
        -e 's/"nvidia-cutlass-dsl\[cu13\]==4\.6\.2"/"nvidia-cutlass-dsl==4.6.2"/' \
        -e 's/"humming-kernels\[cu13\]==0\.1\.12"/"humming-kernels==0.1.12"/' \
        -e 's/^[[:space:]]*"flash-attn-4>=4\.0\.0b18"/  # "flash-attn-4>=4.0.0b18"/' \
        -e 's/^[[:space:]]*"sgl-deep-ep==0\.1\.2"/  # "sgl-deep-ep==0.1.2"/' \
        -e 's/^[[:space:]]*"sgl-deep-gemm==0\.1\.7"/  # "sgl-deep-gemm==0.1.7"/' \
        /opt/verl-sglang-src/python/pyproject.toml \
    && cd /opt/verl-sglang-src \
    && /opt/verl/bin/pip install --no-build-isolation --no-deps -e python/ \
    && http_proxy=http://10.177.8.11:3128 https_proxy=http://10.177.8.11:3128 \
       git clone https://gh-proxy.com/https://github.com/verl-project/verl.git /opt/verl-src \
    && git -C /opt/verl-src checkout -f 0938fcb3 \
    && /opt/verl/bin/pip install --no-cache-dir --no-build-isolation --no-deps -e /opt/verl-src \
    && /opt/verl/bin/python -c "import torch, sglang, sgl_kernel, flashinfer, flash_attn, flash_attn.cute, apex, transformer_engine.pytorch, megatron.core, megatron.bridge, verl; print('Full RL stack verified OK!')" \
    && /usr/local/miniconda3/bin/conda clean -afy \
    && rm -rf /opt/sglang-cache/pip /opt/sglang-cache/conda /opt/verl-sglang-src/rust/target

ENV SGLANG_RUST_BUILD_MODE=never
WORKDIR /opt/verl-src
